[Unit]
Description=Midnight Validator Node (Partner Chain)
Documentation=https://github.com/Kamrank47/midnight-validator-platform
After=network-online.target chronyd.service
Wants=network-online.target

[Service]
Type=simple
User=midnight
Group=midnight
EnvironmentFile=/etc/midnight/validator.env
ExecStart=/usr/local/bin/midnight-node \
  --validator \
  --base-path=/var/lib/midnight/chain-data \
  --keystore-path=/etc/midnight/keystore \
  --port=30333 \
  --rpc-port=9944 \
  --rpc-methods=Safe \
  --prometheus-port=9615
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
LimitNOFILE=65536

# Systemd sandboxing guarantees least privilege on bare-metal hosts
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/midnight/chain-data
ReadOnlyPaths=/etc/midnight/keystore
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=midnight-node

[Install]
WantedBy=multi-user.target
