[Unit]
Description=Substrate Validator Node (Partner Chain)
Documentation=https://github.com/Kamrank47/substrate-validator-ops
After=network-online.target chronyd.service
Wants=network-online.target

[Service]
Type=simple
User=validator
Group=validator
EnvironmentFile=/etc/validator/validator.env
ExecStart=/usr/local/bin/substrate-validator \
  --validator \
  --base-path=/var/lib/validator/chain-data \
  --keystore-path=/etc/validator/keystore \
  --port=30333 \
  --rpc-port=9944 \
  --rpc-methods=Safe \
  --prometheus-port=9615
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
LimitNOFILE=65536

# Systemd sandboxing guarantees least privilege on bare-metal hosts
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/validator/chain-data
ReadOnlyPaths=/etc/validator/keystore
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-validator

[Install]
WantedBy=multi-user.target
